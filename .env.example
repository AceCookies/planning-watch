# ===== CONFIGURATION planning_watch — MODÈLE =====
# Copier en .env et remplir avec les vraies valeurs (JAMAIS commiter le vrai .env)

# --- Site du personnel ---
SITE_URL=https://sitedupersonnel-surete-nantes.hubsafe.eu
SITE_LOGIN=ton_identifiant
SITE_PASSWORD=ton_mot_de_passe
LOGIN_PAGE=/connexion
PLANNING_PAGE=/mon-planning

# --- Discord (webhooks) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx
DISCORD_NEWPLANNING_WEBHOOK_URL=
DISCORD_DOCS_WEBHOOK_URL=
DISCORD_STATUS_WEBHOOK_URL=
DISCORD_PING=
DISCORD_PING_URGENT_ONLY=true

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton_email
SMTP_PASSWORD=mot_de_passe_application
EMAIL_TO=destinataire@example.com

# --- Google Agenda ---
GCAL_ENABLED=true
GCAL_CALENDAR_ID=primary
GCAL_AUTH_METHOD=oauth
GCAL_TIMEZONE=Europe/Paris
GCAL_EVENT_PREFIX=
GCAL_SYNC_CP=true
GCAL_COLOR_FRET=11
GCAL_COLOR_FOR=3
GCAL_COLOR_HSUP=6

# --- Dashboard web (auth) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=choisis_un_mot_de_passe
DASHBOARD_PORT=8080

# --- Notes de service ---
NOTES_ENABLED=true
NOTES_AUTO_MARKLU=false

# --- Divers ---
AUTO_ACKNOWLEDGE=false
NOTIFY_NEW_WEEKS=true
