# --- Site du personnel ---
SITE_URL=
LOGIN_PAGE=/
# Chemin de la page planning : connecte-toi dans ton navigateur, va sur ton
# planning, et copie tout ce qui suit le nom de domaine dans l'URL.
# Exemple : si l'URL est https://sitedupersonnel-.../planete/planning
# alors mets : PLANNING_PAGE=/planete/planning
PLANNING_PAGE=

# --- Tes identifiants (les mêmes que sur le site) ---
SITE_LOGIN=ton_login
SITE_PASSWORD=ton_mot_de_passe

# --- Discord ---
# Serveur Discord > Paramètres du salon > Intégrations > Webhooks > Nouveau webhook
DISCORD_WEBHOOK_URL=

# --- Email (exemple avec Gmail) ---
# Pour Gmail : crée un "mot de passe d'application" sur
# https://myaccount.google.com/apppasswords (nécessite la validation en 2 étapes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.adresse@gmail.com
SMTP_PASSWORD=mot_de_passe_application
EMAIL_TO=ton.adresse@gmail.com

# Notifier aussi quand une nouvelle semaine est publiée (true/false)
NOTIFY_NEW_WEEKS=true

# --- Documents bloquants ---
# Quand un document/notification doit être "pris en compte" avant d'accéder
# au planning :
#   false (recommandé) : tu reçois une notification et tu vas le valider
#   true               : le script le valide automatiquement (vaut confirmation
#                        de lecture, à tes risques !)
AUTO_ACKNOWLEDGE=false

# --- Channel Discord dédié aux documents ---
# Crée un 2e webhook dans le channel où tu veux recevoir les fichiers
# (si vide, les documents sont envoyés dans le même channel que les alertes)
DISCORD_DOCS_WEBHOOK_URL=

# --- Google Agenda ---
GCAL_ENABLED=false
# ID de l'agenda (Paramètres de l'agenda > Intégrer l'agenda > ID de l'agenda)
GCAL_CALENDAR_ID=
# Fichier de clé du compte de service (voir README, étape Google)
GCAL_SERVICE_ACCOUNT_FILE=service_account.json
GCAL_TIMEZONE=Europe/Paris
# Titre des événements créés
GCAL_EVENT_PREFIX=🛡️ Travail
# Créer aussi des événements "journée entière" pour les CP (true/false)
GCAL_SYNC_CP=true
